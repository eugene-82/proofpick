# Public backend URL embedded in the frontend build. Never put provider keys here.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Comma-separated exact browser origins allowed to call the backend (no trailing slash).
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required for live analysis; set real values only in a local shell or platform secrets.
TAVILY_API_KEY=

# Required for live analysis. Tests never call the live API.
OPENAI_API_KEY=

# Optional server-side model overrides.
OPENAI_CLAIM_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
