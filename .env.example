# Local frontend-to-backend base URL. No credentials are required for Task 001.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Comma-separated browser origins allowed to call the backend.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional server-side search provider credential. Leave empty for mock-only tests.
TAVILY_API_KEY=

# Optional claim-extraction settings. Tests never call the live API.
OPENAI_API_KEY=
OPENAI_CLAIM_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
